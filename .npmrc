# Always install devDependencies, whatever NODE_ENV happens to be.
#
# npm reads NODE_ENV: when it is `production`, `omit` defaults to `dev` and
# npm install quietly skips devDependencies — no error, just a repo missing
# its test and build tooling. Some editors and agent tooling export
# NODE_ENV=production for themselves, and child processes inherit it, so this
# can happen on a machine whose own shell is perfectly clean.
#
# `include` takes precedence over `omit`, so this holds regardless.
include=dev
